<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <!-- Modern Typography (Inter font) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- CSS assets (Served locally from node_modules and public) -->
  <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/bootstrap-icons/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="app-body">

  <!-- Sticky Header Partial -->
  <%- include('partials/header') %>

  <!-- Main Content Wrapper -->
  <main class="container-fluid px-4 py-4 animate-fade-in">
    <!-- Contacts Table Content Wrapper (AJAX will replace inner contents) -->
    <div id="table-container">
      <%- include('partials/contacts_table') %>
    </div>
  </main>

  <!-- ================= MODALS ================= -->

  <!-- 1. Add Contact Modal -->
  <div class="modal fade" id="addContactModal" tabindex="-1" aria-labelledby="addContactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content bg-white border-0 rounded-4 shadow-lg text-dark">
        <div class="modal-header border-bottom border-light-blue px-4 py-3">
          <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="addContactModalLabel">
            <i class="bi bi-person-plus-fill text-primary-blue"></i>
            <span class="text-primary-dark">Add New Contact</span>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="add-contact-form" novalidate>
          <div class="modal-body px-4 py-4">
            
            <!-- Error feedback alert inside modal -->
            <div id="add-contact-error" class="alert alert-danger d-none py-2.5 px-3 rounded-3" role="alert">
              <i class="bi bi-exclamation-triangle-fill me-1.5"></i>
              <span class="text-sm" id="add-contact-error-msg">Error details here</span>
            </div>

            <!-- Form Fields -->
            <div class="mb-3">
              <label for="add-name" class="form-label text-sm text-muted-dark fw-medium">Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control bg-light-input border-light-blue text-dark" id="add-name" required placeholder="Enter full name">
            </div>

            <div class="mb-3">
              <label for="add-mobile" class="form-label text-sm text-muted-dark fw-medium">Mobile Number <span class="text-danger">*</span></label>
              <input type="tel" class="form-control bg-light-input border-light-blue text-dark" id="add-mobile" required placeholder="Enter mobile number">
              <div class="text-xxs text-muted mt-1">E.g., 9876543210 (Duplicates are not allowed)</div>
            </div>

            <div class="row mb-3">
              <div class="col-6">
                <label for="add-company" class="form-label text-sm text-muted-dark fw-medium">Company</label>
                <input type="text" class="form-control bg-light-input border-light-blue text-dark" id="add-company" placeholder="e.g. Acme Corp">
              </div>
              <div class="col-6">
                <label for="add-city" class="form-label text-sm text-muted-dark fw-medium">City</label>
                <input type="text" class="form-control bg-light-input border-light-blue text-dark" id="add-city" placeholder="e.g. New York">
              </div>
            </div>

            <div class="mb-3">
              <label for="add-faculty" class="form-label text-sm text-muted-dark fw-medium">Faculty Name</label>
              <select class="form-select bg-light-input border-light-blue text-dark" id="add-faculty">
                <option value="" selected>-- No Faculty Assigned --</option>
                <option value="RAVI JASOLIYA">RAVI JASOLIYA</option>
                <option value="RIDHAM KEVADIYA">RIDHAM KEVADIYA</option>
                <option value="CHIRAG MANGUKIYA">CHIRAG MANGUKIYA</option>
                <option value="ABHI AANKOLIYA">ABHI AANKOLIYA</option>
                <option value="RAJNI SHINGALA">RAJNI SHINGALA</option>
              </select>
            </div>

            <div class="mb-0">
              <label for="add-remark" class="form-label text-sm text-muted-dark fw-medium">Remark</label>
              <textarea class="form-control bg-light-input border-light-blue text-dark" id="add-remark" rows="2" placeholder="Add details or call notes..."></textarea>
            </div>

          </div>
          <div class="modal-footer border-top border-light-blue px-4 py-3">
            <button type="button" class="btn btn-outline-slate rounded-pill px-3.5" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary-blue rounded-pill px-4 d-flex align-items-center gap-1.5">
              <span class="spinner-border spinner-border-sm d-none" id="add-contact-spinner" role="status" aria-hidden="true"></span>
              <span>Save Contact</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- 2. Delete Contact Modal -->
  <div class="modal fade" id="deleteContactModal" tabindex="-1" aria-labelledby="deleteContactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content bg-white border-0 rounded-4 shadow-lg text-dark">
        <div class="modal-header border-bottom border-light-blue px-3 py-2.5">
          <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-1.5 text-md" id="deleteContactModalLabel">
            <i class="bi bi-exclamation-octagon-fill"></i>
            <span>Confirm Delete</span>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body px-3 py-3 text-center">
          <p class="text-sm mb-0">Are you sure you want to permanently delete <strong id="delete-contact-name-placeholder" class="text-dark">this contact</strong>?</p>
          <div class="text-xs text-muted-dark mt-1">This action cannot be undone.</div>
        </div>
        <div class="modal-footer border-top border-light-blue px-3 py-2.5 d-flex justify-content-center gap-2">
          <button type="button" class="btn btn-outline-slate btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="confirm-delete-btn" class="btn btn-danger btn-sm rounded-pill px-3">Delete</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Delete All Contacts Modal -->
  <div class="modal fade" id="deleteAllContactsModal" tabindex="-1" aria-labelledby="deleteAllContactsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content bg-white border-0 rounded-4 shadow-lg text-dark">
        <div class="modal-header border-bottom border-light-blue px-4 py-3">
          <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2" id="deleteAllContactsModalLabel">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>Confirm Delete All</span>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body px-4 py-4 text-center">
          <p class="text-sm mb-0" id="delete-all-prompt-text">Are you sure you want to permanently delete all contacts?</p>
          <div class="text-xs text-muted-dark mt-2">This action cannot be undone and will permanently wipe the selected records from the database.</div>
        </div>
        <div class="modal-footer border-top border-light-blue px-4 py-3 d-flex justify-content-center gap-2">
          <button type="button" class="btn btn-outline-slate rounded-pill px-3.5" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="confirm-delete-all-btn" class="btn btn-danger rounded-pill px-4">Delete All</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating Auto-Next Call Banner -->
  <div id="floating-call-banner" class="floating-banner-container d-none animate-scale-up">
    <button type="button" id="floating-call-btn" class="btn btn-success rounded-pill shadow-lg d-flex align-items-center gap-2 px-4 py-3 text-white fw-bold border-0">
      <i class="bi bi-telephone-fill text-white fs-5"></i>
      <span>Call Next: <span id="floating-next-contact-name">...</span></span>
    </button>
  </div>

  <!-- ================= TOASTS ================= -->
  <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    <div id="statusToast" class="toast bg-white text-dark border-0 rounded-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
      <div class="toast-header bg-light-blue border-bottom border-light text-dark py-2">
        <i id="toast-icon" class="bi bi-info-circle-fill me-2 text-primary-blue"></i>
        <strong id="toast-title" class="me-auto text-primary-dark">Notification</strong>
        <button type="button" class="btn-close" data-bs-toast="toast" aria-label="Close"></button>
      </div>
      <div class="toast-body text-sm py-2.5" id="toast-body-message">
        Operation completed successfully.
      </div>
    </div>
  </div>

  <!-- ================= SCRIPTS ================= -->
  <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>

</body>
</html>
